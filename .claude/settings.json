{
  "askUserQuestionTimeout": "60s",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "SubagentStart": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python scripts/trace_hook.py", "timeout": 10 } ] }
    ]
  }
}
